# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.

# Required: your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Optional: prefix for classic text commands (defaults to !)
COMMAND_PREFIX=!

# Optional: a server ID for instant slash-command updates while developing.
# Leave blank to register commands globally (can take up to an hour to appear).
GUILD_ID=
